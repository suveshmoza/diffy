{
  "name": "diffy",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "1.5.1",
    "@pierre/icons": "^0.9.0",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "markdown-to-jsx": "^9.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "patch-package": "^8.0.1",
    "shiki": "^4.4.3",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
